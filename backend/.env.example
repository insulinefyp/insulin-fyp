NODE_ENV=development
PORT=3000
HOST=0.0.0.0
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d

GLUCOSE_SOURCE=simulator
CGM_INTERVAL_SECONDS=60
CGM_STALE_AFTER_INTERVALS=3
SIMULATOR_ENABLED=true
SIMULATOR_CONTROLS_ENABLED=true

ESP32_ENABLED=true
ESP32_HOST=192.168.1.50
ESP32_PORT=80
ESP32_POLL_INTERVAL_SECONDS=3
ESP32_TIMEOUT_MS=2000
ESP32_FAILURES_BEFORE_OFFLINE=3
